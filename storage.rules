rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Publicly readable ad-card images; uploads are restricted to the verified primary admin.
    match /adCards/{imagePath=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == "mohistudio95@gmail.com"
        && request.auth.token.email_verified == true
        && request.resource != null
        && request.resource.size <= 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if request.auth != null
        && request.auth.token.email == "mohistudio95@gmail.com"
        && request.auth.token.email_verified == true;
    }
  }
}
